# SentinelRAG Environment Variables Example
# Do NOT place real secrets, API keys, or credentials in this file or any .env file.
# Copy this file to .env for local development overrides.

# Environment definition (e.g., development, staging)
SENTINELRAG_ENV=development

# Logging verbosity
SENTINELRAG_LOG_LEVEL=INFO

# External model integration configuration (Implemented in Phase 1B)
# Use 'disabled', 'ollama', or 'lm_studio'
SENTINELRAG_PROVIDER=ollama

# The local endpoint for the model provider.
# MUST be a loopback address (127.0.0.1, ::1, [::1], or localhost)
SENTINELRAG_ENDPOINT=http://127.0.0.1:11434/api

# The model identifier to use (e.g. 'llama3' for Ollama or 'local-model' for LM Studio)
SENTINELRAG_MODEL_IDENTIFIER=llama3

# Maximum tokens to request in a single generation
SENTINELRAG_MAX_REQUESTED_OUTPUT_TOKENS=1024

# Timeouts and retries
SENTINELRAG_TIMEOUT=5.0
SENTINELRAG_RETRY_LIMIT=1
