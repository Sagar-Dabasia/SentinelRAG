# SentinelRAG Environment Variables Example
# Do NOT place real secrets, API keys, or credentials in this file or any .env file.
# Copy this file to .env for local development overrides.

# Environment definition (e.g., development, test, production)
SENTINELRAG_ENVIRONMENT=development

# Logging verbosity
SENTINELRAG_LOG_LEVEL=INFO

# External model integration configuration
# Use 'disabled', 'ollama', or 'lm_studio'
SENTINELRAG_PROVIDER=disabled

# Opt-in examples for Ollama:
# SENTINELRAG_PROVIDER=ollama
# SENTINELRAG_ENDPOINT=http://127.0.0.1:11434/api
# SENTINELRAG_MODEL_IDENTIFIER=<local-model>

# Actual implemented setting names (commented as they have safe defaults):
# SENTINELRAG_CONNECT_TIMEOUT=
# SENTINELRAG_READ_TIMEOUT=
# SENTINELRAG_WRITE_TIMEOUT=
# SENTINELRAG_POOL_TIMEOUT=
# SENTINELRAG_RETRY_LIMIT=
# SENTINELRAG_MAX_REQUESTED_OUTPUT_TOKENS=
# SENTINELRAG_MAX_RESPONSE_CHARACTERS=
# SENTINELRAG_MAX_RESPONSE_BYTES=
